  "referrerPolicy": {
    "publicSuffixPackage": "tldts",
    "publicSuffixVersion": "7.4.19",
    "domainScope": "icann-registrable",
    "hostnamePattern": "^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])$",
    "opaqueLabelPattern": "[a-z0-9]{32,}|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}",
    "excludedSuffixes": [
      "stellaratlas.io",
      "localhost",
      "local",
      "internal",
      "intranet",
      "corp",
      "home",
      "lan",
      "test",
      "example",
      "example.com",
      "example.net",
      "example.org",
      "invalid",
      "onion",
      "arpa"
    ]
  }
}
