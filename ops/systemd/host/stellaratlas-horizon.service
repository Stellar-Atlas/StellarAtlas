[Unit]
Description=StellarAtlas owned Horizon API on host-native storage
Requires=stellaratlas-horizon-postgres.service
After=stellaratlas-horizon-postgres.service
RequiresMountsFor=/mnt/bulk/stellarbeat-data/horizon
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=admins
Group=admins
WorkingDirectory=/mnt/bulk/stellarbeat-data/horizon
Environment=NETWORK=pubnet
Environment=PORT=18000
Environment=ADMIN_PORT=18001
Environment=INGEST=true
Environment=APPLY_MIGRATIONS=true
Environment=DISABLE_TX_SUB=true
Environment=HISTORY_RETENTION_COUNT=0
Environment=CAPTIVE_CORE_HTTP_PORT=11626
Environment=CAPTIVE_CORE_PEER_PORT=11725
Environment=CAPTIVE_CORE_STORAGE_PATH=/mnt/bulk/stellarbeat-data/horizon/captive-core/pubnet
Environment=CAPTIVE_CORE_LOG_PATH=/mnt/bulk/stellarbeat-data/horizon/logs/captive-core.log
Environment=STELLAR_CORE_BINARY_PATH=/mnt/bulk/stellarbeat-data/stellar-core/bin/stellar-core
Environment=LD_LIBRARY_PATH=/mnt/bulk/stellarbeat-data/stellar-core/runtime/usr/lib/x86_64-linux-gnu
ExecStart=/usr/bin/env DATABASE_URL=postgresql://observe@/horizon?host=/mnt/bulk/stellarbeat-data/horizon/postgres/run&port=5433&sslmode=disable /mnt/bulk/stellarbeat-data/horizon/bin/horizon serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=32G
CPUWeight=25
IOWeight=25
Nice=5

[Install]
WantedBy=multi-user.target
