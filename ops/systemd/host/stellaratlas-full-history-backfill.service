[Unit]
Description=StellarAtlas bounded canonical full-history backfill on host-native storage
After=network-online.target stellaratlas-postgresql.service
Wants=network-online.target
Requires=stellaratlas-postgresql.service

[Service]
Type=simple
User=admins
Group=admins
WorkingDirectory=/mnt/bulk/stellarbeat-data/Observer
Environment=NODE_ENV=production
Environment=HOME=/home/admins
Environment=PATH=/home/admins/.nvm/versions/node/v26.5.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=FULL_HISTORY_CONTINUOUS_BACKFILL_ENABLED=true
Environment="FULL_HISTORY_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015"
Environment=FULL_HISTORY_BACKFILL_CHECKPOINTS=4
Environment=FULL_HISTORY_BACKFILL_SUCCESS_DELAY_MS=250
Environment=FULL_HISTORY_BACKFILL_IDLE_BACKOFF_MS=15000
Environment=FULL_HISTORY_BACKFILL_PROOF_PENDING_BACKOFF_MS=30000
Environment=FULL_HISTORY_BACKFILL_EVIDENCE_REJECTED_BACKOFF_MS=60000
Environment=FULL_HISTORY_BACKFILL_ERROR_BACKOFF_MS=30000
Environment=FULL_HISTORY_BACKFILL_HEARTBEAT_MS=60000
Environment=FULL_HISTORY_BACKFILL_RETRY_MS=30000
EnvironmentFile=-/etc/stellaratlas/stellaratlas.env
ExecStartPre=/usr/bin/env node scripts/wait-for-url.mjs http://192.168.1.221:3000/v1/status 90
ExecStart=/usr/bin/env pnpm start:full-history-backfill
Restart=always
RestartSec=15
TimeoutStopSec=360
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
