[Unit]
Description=StellarAtlas history archive broker dispatcher
After=network-online.target stellaratlas-postgresql.service stellaratlas-nats.service
Wants=network-online.target
Requires=stellaratlas-postgresql.service stellaratlas-nats.service
RequiresMountsFor=/mnt/bulk/stellarbeat-data/Observer

[Service]
Type=simple
User=admins
Group=admins
WorkingDirectory=/mnt/bulk/stellarbeat-data/Observer
Environment=NODE_ENV=production
Environment=HOME=/home/admins
Environment=PATH=/home/admins/.nvm/versions/node/v26.5.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/stellaratlas/stellaratlas.env
EnvironmentFile=/etc/stellaratlas/nats.env
EnvironmentFile=/etc/stellaratlas/archive-verifier-steady.env
Environment=NATS_SERVERS=nats://127.0.0.1:4222
ExecStart=/home/admins/.nvm/versions/node/v26.5.1/bin/pnpm start:history-archive-broker-dispatcher
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
