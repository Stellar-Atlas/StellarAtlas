[Unit]
Description=StellarAtlas NATS JetStream scheduler
After=network.target

[Service]
Type=simple
User=admins
Group=admins
EnvironmentFile=/etc/stellaratlas/nats.env
ExecStart=/usr/sbin/nats-server --config /etc/stellaratlas/nats.conf
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stellaratlas/nats

[Install]
WantedBy=multi-user.target
