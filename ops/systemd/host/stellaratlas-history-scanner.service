[Unit]
Description=StellarAtlas history scanner on host-native storage
After=network-online.target stellaratlas-postgresql.service
Wants=network-online.target
Requires=stellaratlas-postgresql.service
RequiresMountsFor=/mnt/bulk/stellarbeat-data/Observer/history-bucket-cache

[Service]
Type=simple
User=admins
Group=admins
WorkingDirectory=/mnt/bulk/stellarbeat-data/Observer
Environment=NODE_ENV=production
Environment=HOME=/home/admins
Environment=PATH=/home/admins/.nvm/versions/node/v26.5.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HISTORY_OBJECT_WORKER_PROCESSES=24
Environment=HISTORY_OBJECT_DOWNLOAD_CONCURRENCY=8
Environment=HISTORY_HASHER_WORKERS=24
Environment=HISTORY_SCAN_WORKERS=1
Environment=HISTORY_BUCKET_CACHE_DIR=/mnt/bulk/stellarbeat-data/Observer/history-bucket-cache
ExecStartPre=/home/admins/.nvm/versions/node/v26.5.1/bin/node scripts/wait-for-url.mjs http://192.168.1.221:3000/v1/status 90
ExecStart=/home/admins/.nvm/versions/node/v26.5.1/bin/pnpm start:scan-history
Restart=always
RestartSec=15
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
