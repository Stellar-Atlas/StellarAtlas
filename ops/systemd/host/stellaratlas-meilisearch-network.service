[Unit]
Description=StellarAtlas network Meilisearch on host-native storage
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/bulk/stellarbeat-data/meilisearch/network

[Service]
Type=simple
User=admins
Group=admins
UMask=0077
Environment=MEILI_ENV=production
Environment=MEILI_HTTP_ADDR=192.168.1.153:7701
Environment=MEILI_DB_PATH=/mnt/bulk/stellarbeat-data/meilisearch/network/data
Environment=MEILI_DUMP_DIR=/mnt/bulk/stellarbeat-data/meilisearch/network/dumps
Environment=MEILI_SNAPSHOT_DIR=/mnt/bulk/stellarbeat-data/meilisearch/network/snapshots
Environment=MEILI_NO_ANALYTICS=true
Environment=MEILI_MAX_INDEXING_MEMORY=4294967296
Environment=MEILI_MAX_INDEXING_THREADS=4
Environment=MEILI_EXPERIMENTAL_SEARCH_QUEUE_SIZE=256
Environment=MEILI_HTTP_PAYLOAD_SIZE_LIMIT=16777216
EnvironmentFile=/etc/stellaratlas/meilisearch-network.env
ExecStartPre=/usr/bin/mkdir -p /mnt/bulk/stellarbeat-data/meilisearch/network/data /mnt/bulk/stellarbeat-data/meilisearch/network/dumps /mnt/bulk/stellarbeat-data/meilisearch/network/snapshots
ExecStart=/home/admins/.local/bin/meilisearch
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryHigh=6G
MemoryMax=8G
CPUQuota=800%
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
