<clickhouse>
    <profiles>
        <stellaratlas_etl>
            <max_threads>16</max_threads>
            <max_memory_usage>137438953472</max_memory_usage>
            <max_execution_time>3600</max_execution_time>
        </stellaratlas_etl>
        <stellaratlas_api>
            <readonly>1</readonly>
            <max_threads>8</max_threads>
            <max_memory_usage>34359738368</max_memory_usage>
            <max_execution_time>30</max_execution_time>
            <max_result_rows>10000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
        </stellaratlas_api>
    </profiles>

    <users>
        <default>
            <password remove="remove"/>
            <password_sha256_hex>__DEFAULT_PASSWORD_SHA256__</password_sha256_hex>
