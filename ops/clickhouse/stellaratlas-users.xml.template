                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
        </default>
        <stellaratlas_etl>
            <password_sha256_hex>__ETL_PASSWORD_SHA256__</password_sha256_hex>
            <networks>
                <ip>127.0.0.1</ip>
            </networks>
            <profile>stellaratlas_etl</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </stellaratlas_etl>
        <stellaratlas_api>
            <password_sha256_hex>__API_PASSWORD_SHA256__</password_sha256_hex>
            <networks>
                <ip>192.168.122.2</ip>
            </networks>
            <profile>stellaratlas_api</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </stellaratlas_api>
    </users>
</clickhouse>
