{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "check: TypeScript workspace",
			"type": "shell",
			"command": "pnpm",
			"args": ["exec", "tsc", "--build", "--pretty", "false"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"clear": true,
				"panel": "dedicated",
				"reveal": "always"
			}
		},
		{
			"label": "check: ESLint workspace",
			"type": "shell",
			"command": "pnpm",
			"args": ["lint"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": {
				"owner": "eslint",
				"source": "eslint",
				"applyTo": "allDocuments",
				"fileLocation": "absolute",
				"pattern": [
					{
						"regexp": "^(/.*)$",
						"file": 1
					},
					{
						"regexp": "^\\s+(\\d+):(\\d+)\\s+(error|warning)\\s+(.*?)(?:\\s{2,}(\\S+))?\\s*$",
						"line": 1,
						"column": 2,
						"severity": 3,
						"message": 4,
						"code": 5,
						"loop": true
					}
				]
			},
			"presentation": {
				"clear": true,
				"panel": "dedicated",
				"reveal": "always"
			}
		},
		{
			"label": "check: entire workspace",
			"dependsOrder": "sequence",
			"dependsOn": [
				"check: TypeScript workspace",
				"check: ESLint workspace"
			],
			"problemMatcher": []
		}
	]
}
